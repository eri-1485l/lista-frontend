[DEFAULT]
bantime = 600
findtime = 10
maxretry = 5
bantime.increment = true
bantime.factor = 2
bantime.maxtime = 1d
ignoreip = 127.0.0.1/8 172.29.0.20

[sshd]
enabled = false

[sshd-ddos]
enabled = false

[frontend-flood]
enabled = true
port = 5173
filter = frontend-flood
logpath = /var/log/nginx/access.log
maxretry = 5
findtime = 10
bantime = 600
action = iptables-allports[name=frontend-flood]
